{
  "name": "@cocoapilot/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "The MCP server and CLI that report to a CoCoaPilot board. Fetched by npx; never needs a path to the desktop app.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cocoapilot-mcp": "dist/mcp/main.js",
    "cocoapilot": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonupchurch/CoCoPilot.git",
    "directory": "packages/clients"
  },
  "homepage": "https://github.com/jonupchurch/CoCoPilot#readme",
  "bugs": "https://github.com/jonupchurch/CoCoPilot/issues",
  "keywords": [
    "cocoapilot",
    "mcp",
    "model-context-protocol",
    "spec-kit",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cocoapilot/contract": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cocoapilot/board": "*"
  }
}
