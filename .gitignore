# Spec-Kit state is tracked here on purpose. `specs/` and `.specify/feature.json`
# are this project's source of truth, so unlike the ai-tools repo this toolkit
# was copied from (which ships the engine without any one project's state),
# neither is ignored.

# Machine-local Claude Code settings (permissions/paths, never shared).
# Personal overrides like defaultMode belong here, not in settings.json.
.claude/settings.local.json

# Env files (never commit secrets)
.env*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
*.pem

# Node / TypeScript
node_modules/
dist/
out/
coverage/
*.tsbuildinfo

# Vitest
.vitest/

# Playwright
test-results/
playwright-report/
.playwright/

# Staged copies of the board's build, produced by packages/runner/scripts/stage.mjs.
# One build feeds both distribution routes; these are the copy, not the source.
# `resources/` is staged alongside `out/` because electron-vite's `?asset` imports
# resolve to it at runtime — see the note in stage.mjs.
packages/runner/out/
packages/runner/resources/
